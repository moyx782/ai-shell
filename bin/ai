#!/usr/bin/env python3
"""A persistent terminal REPL backed by explicit OpenCode sessions."""
import argparse
import json
import os
from pathlib import Path
import shlex
import shutil
import signal
import subprocess

VERSION = "0.1.0"

try:
    import readline  # Enables line editing and in-process input history.
except ImportError:
    pass

HELP = """直接输入任务，回车发送。
/help           显示帮助
/model          查看模型设置并列出可用模型
/model 提供商/模型  切换模型，下一轮生效，保留会话
/model default  取消模型覆盖，交由 OpenCode 选择
/status         当前目录、会话和 Git 状态
/git            查看 Git diff
/files          列出项目文件（最多 200 个）
/run 命令       执行本地 shell 命令
/cd 路径        切换目录并开始新会话
/new            开始新会话
/exit           退出（也可输入 exit、quit 或按 Ctrl-D）
Ctrl-C          中断当前任务，保留 REPL
"""


def stop(process):
    if process.poll() is None:
        os.killpg(process.pid, signal.SIGINT)
        try:
            process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            process.wait()


def local(command, shell=False):
    process = subprocess.Popen(command, shell=shell, start_new_session=True)
    try:
        code = process.wait()
        if code:
            print(f"[命令退出码：{code}]")
    except KeyboardInterrupt:
        stop(process)
        print("\n[已中断]")


def ask(prompt, session, options):
    command = ["opencode", "run", "--format", "json"]
    if session:
        command += ["--session", session]
    if options.model:
        command += ["--model", options.model]
    if options.agent:
        command += ["--agent", options.agent]
    command += ["--", prompt]
    process = subprocess.Popen(command, stdout=subprocess.PIPE, text=True,
                               encoding="utf-8", errors="replace",
                               start_new_session=True)
    try:
        for line in process.stdout:
            try:
                event = json.loads(line)
            except ValueError:
                print(line, end="", flush=True)
                continue
            if not isinstance(event, dict):
                print(line, end="", flush=True)
                continue
            session = event.get("sessionID") or session
            kind = event.get("type")
            part = event.get("part") or {}
            if kind == "text":
                print(part.get("text", ""), flush=True)
            elif kind == "tool_use":
                state = part.get("state") or {}
                print(f"[工具：{part.get('tool', '?')} · {state.get('status', '')}]", flush=True)
                output = state.get("output") or state.get("error")
                if output:
                    print(output, flush=True)
            elif kind == "error":
                print("[OpenCode 错误]", json.dumps(event.get("error", event), ensure_ascii=False))
        code = process.wait()
        if code:
            print(f"[OpenCode 退出码：{code}]")
    except KeyboardInterrupt:
        stop(process)
        print("\n[已中断，返回 ai>]")
    finally:
        process.stdout.close()
        stop(process)
    if not session:
        print("[尚未获得会话 ID；下一轮将创建新会话]")
    return session


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--version", action="version", version=f"ai-shell {VERSION}")
    parser.add_argument("--model", "-m")
    parser.add_argument("--agent")
    parser.add_argument("--session", "-s", help="恢复指定 OpenCode 会话")
    parser.add_argument("prompt", nargs="*", help="进入 REPL 后先执行的任务")
    options = parser.parse_args()
    if not shutil.which("opencode"):
        parser.exit(1, "找不到 opencode，请先安装并加入 PATH。\n")
    session = options.session
    pending = " ".join(options.prompt)
    print("╭────────────────────╮\n│  AI Coding Shell   │\n╰────────────────────╯")
    print("输入 /help 查看命令；exit 退出。")
    while True:
        try:
            cmd = pending or input("ai> ")
            pending = ""
            cmd = cmd.strip()
            if not cmd:
                continue
            if cmd in ("exit", "quit", "/exit", "/quit"):
                break
            pieces = cmd.split(maxsplit=1)
            name = pieces[0]
            argument = pieces[1] if len(pieces) > 1 else ""
            if name == "/help":
                print(HELP)
            elif name in ("/model", "/models"):
                model = argument.strip()
                if not model or model == "list":
                    print(f"模型设置：{options.model or '由 OpenCode 选择（未指定覆盖）'}", flush=True)
                    print("可用模型：", flush=True)
                    local(["opencode", "models"])
                    print("使用 /model 提供商/模型 切换；/model default 取消覆盖。")
                elif model == "default":
                    options.model = None
                    print("[已取消模型覆盖；后续由 OpenCode 按会话或配置选择模型]")
                elif "/" not in model or any(c.isspace() for c in model) or not all(model.split("/", 1)):
                    print("用法：/model 提供商/模型；输入 /model 查看可用模型。")
                else:
                    options.model = model
                    print(f"[模型已设为 {model}；下一轮生效，保留当前会话]")
            elif name == "/new":
                session = None
                print("[新会话将在下次发送任务时创建]")
            elif name == "/status":
                print(f"目录：{Path.cwd()}\n会话：{session or '尚未创建'}\n模型设置：{options.model or '由 OpenCode 选择（未指定覆盖）'}", flush=True)
                local(["git", "status", "--short", "--branch"])
            elif name == "/git":
                local(["git", "--no-pager", "diff"])
            elif name == "/files":
                if shutil.which("rg"):
                    result = subprocess.run(["rg", "--files"], capture_output=True, text=True)
                    files = result.stdout.splitlines()
                    print("\n".join(files[:200]))
                    if len(files) > 200:
                        print(f"[共 {len(files)} 个文件，仅显示前 200 个]")
                    if result.stderr:
                        print(result.stderr, end="")
                else:
                    print("\n".join(sorted(p.name for p in Path.cwd().iterdir())))
            elif name == "/run":
                if argument.strip():
                    local(argument, shell=True)
                else:
                    print("用法：/run npm test")
            elif name == "/cd":
                paths = shlex.split(argument)
                if len(paths) > 1:
                    print('路径包含空格时请使用引号：/cd "my project"')
                    continue
                os.chdir(os.path.expanduser(paths[0] if paths else "~"))
                session = None
                print(f"[目录：{Path.cwd()}；已切换到新会话]")
            elif cmd.startswith("/"):
                print("未知命令，输入 /help 查看帮助。")
            else:
                session = ask(cmd, session, options)
        except EOFError:
            print()
            break
        except KeyboardInterrupt:
            print("\n[已取消输入]")
        except (OSError, ValueError) as error:
            print(f"[错误] {error}")
    if session:
        resume = ["ai", "--session", session]
        if options.model:
            resume += ["--model", options.model]
        if options.agent:
            resume += ["--agent", options.agent]
        print(f"恢复本次会话：{shlex.join(resume)}")


if __name__ == "__main__":
    main()
